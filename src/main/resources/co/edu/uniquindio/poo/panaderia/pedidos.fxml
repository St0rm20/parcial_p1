<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="640.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewcontrollers.PedidoViewController">
   <children>
      <Text fill="#8a4b08" layoutX="20.0" layoutY="40.0" text="Gestion de pedidos">
         <font><Font name="System Bold" size="22.0" /></font>
      </Text>
      <Separator layoutX="20.0" layoutY="52.0" prefWidth="860.0" />

      <Label layoutX="20.0" layoutY="70.0" text="Codigo" />
      <TextField fx:id="txtCodigo" layoutX="20.0" layoutY="90.0" prefWidth="150.0" promptText="P01" />
      <Label layoutX="190.0" layoutY="70.0" text="Cliente" />
      <TextField fx:id="txtCliente" layoutX="190.0" layoutY="90.0" prefWidth="250.0" />
      <Label layoutX="460.0" layoutY="70.0" text="Tipo de pan" />
      <ComboBox fx:id="cbTipoPan" layoutX="460.0" layoutY="90.0" prefWidth="170.0" />
      <Label layoutX="650.0" layoutY="70.0" text="Cantidad" />
      <TextField fx:id="txtCantidad" layoutX="650.0" layoutY="90.0" prefWidth="120.0" />

      <Button layoutX="20.0" layoutY="135.0" mnemonicParsing="false" onAction="#registrarPedidoEvent" prefWidth="170.0" text="Registrar pedido" />
      <Button layoutX="205.0" layoutY="135.0" mnemonicParsing="false" onAction="#asignarPedidoEvent" prefWidth="170.0" text="Asignar a produccion" />
      <Button layoutX="390.0" layoutY="135.0" mnemonicParsing="false" onAction="#cancelarPedidoEvent" prefWidth="170.0" text="Cancelar pedido" />
      <Button layoutX="780.0" layoutY="135.0" mnemonicParsing="false" onAction="#volverEvent" prefWidth="100.0" text="Volver" />
      <Label layoutX="20.0" layoutY="168.0" text="Para asignar o cancelar, seleccione un pedido de la tabla o escriba su codigo." textFill="#6b6b6b" />

      <Label layoutX="20.0" layoutY="192.0" text="Historial de pedidos">
         <font><Font name="System Bold" size="14.0" /></font>
      </Label>
      <TableView fx:id="tblPedidos" layoutX="20.0" layoutY="215.0" prefHeight="210.0" prefWidth="860.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Codigo" />
            <TableColumn fx:id="colCliente" prefWidth="200.0" text="Cliente" />
            <TableColumn fx:id="colTipoPan" prefWidth="120.0" text="Tipo de pan" />
            <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
            <TableColumn fx:id="colEmpleado" prefWidth="120.0" text="Empleado" />
            <TableColumn fx:id="colMinutos" prefWidth="125.0" text="Min. reservados" />
         </columns>
      </TableView>

      <Label layoutX="20.0" layoutY="437.0" text="Disponibilidad de empleados">
         <font><Font name="System Bold" size="14.0" /></font>
      </Label>
      <TableView fx:id="tblEmpleados" layoutX="20.0" layoutY="460.0" prefHeight="165.0" prefWidth="860.0">
         <columns>
            <TableColumn fx:id="colEmpCodigo" prefWidth="100.0" text="Codigo" />
            <TableColumn fx:id="colEmpNombre" prefWidth="250.0" text="Nombre" />
            <TableColumn fx:id="colEmpTipo" prefWidth="250.0" text="Tipo" />
            <TableColumn fx:id="colEmpMinutos" prefWidth="255.0" text="Minutos disponibles" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
