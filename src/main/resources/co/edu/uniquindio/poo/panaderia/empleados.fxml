<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="560.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewcontrollers.EmpleadoViewController">
   <children>
      <Text fill="#8a4b08" layoutX="20.0" layoutY="40.0" text="Registro de empleados">
         <font><Font name="System Bold" size="22.0" /></font>
      </Text>
      <Separator layoutX="20.0" layoutY="52.0" prefWidth="720.0" />

      <Label layoutX="20.0" layoutY="70.0" text="Tipo" />
      <ComboBox fx:id="cbTipo" layoutX="20.0" layoutY="90.0" prefWidth="220.0" />
      <Label layoutX="260.0" layoutY="70.0" text="Nombre" />
      <TextField fx:id="txtNombre" layoutX="260.0" layoutY="90.0" prefWidth="220.0" />
      <Label layoutX="500.0" layoutY="70.0" text="Documento" />
      <TextField fx:id="txtDocumento" layoutX="500.0" layoutY="90.0" prefWidth="220.0" />

      <Label layoutX="20.0" layoutY="130.0" text="Codigo" />
      <TextField fx:id="txtCodigo" layoutX="20.0" layoutY="150.0" prefWidth="220.0" />
      <Label layoutX="260.0" layoutY="130.0" text="Minutos disponibles" />
      <TextField fx:id="txtMinutos" layoutX="260.0" layoutY="150.0" prefWidth="220.0" />
      <Label layoutX="500.0" layoutY="130.0" text="Caja (solo cajeros)" />
      <TextField fx:id="txtCaja" disable="true" layoutX="500.0" layoutY="150.0" prefWidth="220.0" />

      <Button layoutX="20.0" layoutY="195.0" mnemonicParsing="false" onAction="#registrarEmpleadoEvent" prefWidth="220.0" text="Registrar empleado" />
      <Button layoutX="620.0" layoutY="195.0" mnemonicParsing="false" onAction="#volverEvent" prefWidth="100.0" text="Volver" />

      <TableView fx:id="tblEmpleados" layoutX="20.0" layoutY="240.0" prefHeight="300.0" prefWidth="720.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Codigo" />
            <TableColumn fx:id="colNombre" prefWidth="140.0" text="Nombre" />
            <TableColumn fx:id="colDocumento" prefWidth="110.0" text="Documento" />
            <TableColumn fx:id="colTipo" prefWidth="160.0" text="Tipo" />
            <TableColumn fx:id="colMinutos" prefWidth="130.0" text="Minutos disp." />
            <TableColumn fx:id="colCaja" prefWidth="95.0" text="Caja" />
         </columns>
      </TableView>
   </children>
</AnchorPane>
